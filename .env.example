# Backend only. Copy to backend/.env or the backend root and never commit real values.

# LLM provider 1 — preferred
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# LLM provider 2 — fallback (separate key and model)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Shared search provider — independent of the LLM vendor
TAVILY_API_KEY=

# Provider order: comma-separated list of configured providers
AI_PROVIDER_ORDER=openrouter,groq

# App configuration
APP_ENV=development
DATABASE_URL=sqlite:///./oauth_compass.db
FRONTEND_ORIGIN=http://localhost:5173
API_TIMEOUT_SECONDS=25
MAX_RESEARCH_PAGES=8
MAX_PAGE_BYTES=1500000
